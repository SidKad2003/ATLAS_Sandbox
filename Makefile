# svc-sim test bed. Run on svc-sim-host. See docs/RUNBOOK.md.
SHELL := /bin/bash
.DEFAULT_GOAL := help

export SVC_SIM_ROOT := $(CURDIR)
UPSTREAM_REPO := https://github.com/open-telemetry/opentelemetry-demo.git
UPSTREAM_TAG  := 3.1.0
UPSTREAM_SHA  := dedc0178918e260823323b8d95005a8cb924b007
UP            := upstream/opentelemetry-demo

# flagd-ui needs a session key; generated by `make secrets`, never printed.
export SVC_SIM_FLAGD_UI_SECRET_KEY_BASE = $(shell cat ops/secrets/flagd_ui_secret_key_base 2>/dev/null)

UP_ENV   := --env-file $(UP)/.env $(if $(wildcard $(UP)/.env.override),--env-file $(UP)/.env.override,)
SHOP     := -f $(UP)/compose.yaml -f $(UP)/compose.full.yaml -f $(UP)/compose.observability.yaml -f compose/shop.override.yaml -f compose/shop.pins.yaml
DC_SVC_SIM := docker compose -p svc-sim --project-directory $(UP) $(UP_ENV) $(SHOP) -f compose/svc-sim.yaml --profile svc-sim

WORKLOAD ?= svc-sim
SEED     ?= 42
SHOPPERS ?= 5
TICKS    ?= 60

.PHONY: help
help: ## List targets
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-22s %s\n", $$1, $$2}'

.PHONY: fetch-upstream
fetch-upstream: ## Clone the pinned OpenTelemetry Demo release and verify its commit
	@if [ ! -d $(UP)/.git ]; then git clone -q --depth 1 --branch $(UPSTREAM_TAG) $(UPSTREAM_REPO) $(UP); fi
	@test "$$(git -C $(UP) rev-parse HEAD)" = "$(UPSTREAM_SHA)" || { echo "upstream SHA mismatch"; exit 1; }
	@echo "upstream $(UPSTREAM_TAG) @ $(UPSTREAM_SHA) OK"

.PHONY: deploy
deploy: ## Build then start (stops on the first failure)
	$(MAKE) build
	$(MAKE) up-svc-sim

.PHONY: backup restore
backup: ## Back up all svc-sim data to S3 (svc-sim/backups/<timestamp>/)
	@bash ops/scripts/backup.sh
restore: ## Restore from S3: make restore FROM=s3://.../svc-sim/backups/<timestamp> [SHOP_DB=1]
	@bash ops/scripts/restore.sh $(FROM) $(if $(SHOP_DB),--with-shop-db,)

.PHONY: s3-timers telemetry-sync
s3-timers: ## Install host timers: telemetry to S3 every 15 min, full backup nightly at 02:00 UTC
	@sudo bash ops/scripts/install-timers.sh $(CURDIR)
telemetry-sync: ## Upload collector telemetry files to S3 now
	@sudo bash ops/scripts/telemetry-sync.sh $(CURDIR)

.PHONY: mirror-export
mirror-export: ## Build the sanitised open-source mirror branch (atlas-main) from main; then: git push atlas
	@bash ops/scripts/mirror-export.sh

.PHONY: pin-digests
pin-digests: ## Re-pin upstream images to the digests currently running (after a tested upgrade only)
	@bash ops/scripts/pin-digests.sh

.PHONY: hooks
hooks: ## Install the git pre-commit hook (banned-term check)
	@# copy (not core.hooksPath) so local-only hooks such as a pre-push remote guard keep working
	@install -m 0755 ops/hooks/pre-commit .git/hooks/pre-commit && echo "pre-commit hook installed (.git/hooks/pre-commit)"

.PHONY: check
check: ## Offline checks: banned terms, Python unit tests, JS syntax (same as CI)
	@bash ops/scripts/banned-check.sh
	docker run --rm -e OTEL_SDK_DISABLED=true svc-sim/py:dev sh -c "cd /app && python -m pytest -q -p no:cacheprovider viz_bridge/test_mapping.py tests/unit"
	docker run --rm -v $(CURDIR)/viz/web:/w:ro node:22-alpine sh -c 'for f in /w/src/*.js; do node --check $$f || exit 1; done; echo js ok'

.PHONY: secrets
secrets: ## Generate local passwords into ops/secrets (mode 0600, never displayed)
	@bash ops/scripts/gen-secrets.sh

runtime/flagd/demo.flagd.json:
	@mkdir -p runtime/flagd
	@cp $(UP)/src/flagd/demo.flagd.json runtime/flagd/demo.flagd.json
	@# flagd, flagd-ui and the conductor run as different uids and all write this one file
	@chmod 0777 runtime/flagd && chmod 0666 runtime/flagd/demo.flagd.json

runtime/telemetry:
	@mkdir -p runtime/telemetry && chmod 0755 runtime/telemetry

.PHONY: prepare
prepare: fetch-upstream secrets runtime/flagd/demo.flagd.json runtime/telemetry

.PHONY: build
build: prepare ## Build the svc-sim images
	docker build -t svc-sim/py:dev -f docker/py.Dockerfile .
	docker build -t svc-sim/viz:dev -f viz/web/Dockerfile viz/web

.PHONY: up-svc-sim
up-svc-sim: prepare ## Start the shop and the agent layer (localhost only)
	$(DC_SVC_SIM) up -d --remove-orphans
	@bash ops/scripts/wait-healthy.sh svc-sim 600

.PHONY: up-shop
up-shop: prepare ## Start only the shop baseline (Phase 1)
	docker compose -p svc-sim --project-directory $(UP) $(UP_ENV) $(SHOP) up -d --remove-orphans

.PHONY: down-svc-sim
down-svc-sim: ## Stop svc-sim completely (volumes kept)
	$(DC_SVC_SIM) down --remove-orphans

.PHONY: up-agent-eval down-agent-eval
up-agent-eval down-agent-eval:
	@echo "agent-eval is not added yet"; exit 1

.PHONY: switch
switch: ## Stop the other workload, verify it is gone, then start WORKLOAD
	@bash ops/scripts/switch.sh $(WORKLOAD)

.PHONY: loadgen-on loadgen-off
loadgen-on: ## Baseline: restart load-generator with autostart
	SVC_SIM_LOADGEN_AUTOSTART=true $(DC_SVC_SIM) up -d --no-deps load-generator
loadgen-off: ## Agent runs: load-generator idle (default)
	SVC_SIM_LOADGEN_AUTOSTART=false $(DC_SVC_SIM) up -d --no-deps load-generator

.PHONY: run
run: ## Start a seeded sim run (SEED, SHOPPERS, TICKS)
	@docker exec svc-sim-conductor python -m agents.conductor_cli start --seed $(SEED) --shoppers $(SHOPPERS) --ticks $(TICKS)

.PHONY: scenarios replays scenario live-demo
scenarios: ## List the replay scenarios
	@docker exec svc-sim-conductor python -m agents.scenarios list
replays: ## Record every scenario once, one after another (about 25 minutes)
	@docker exec svc-sim-conductor python -u -m agents.scenarios replays
scenario: ## Run one scenario (NAME=payment-outage)
	@docker exec svc-sim-conductor python -u -m agents.scenarios run $(NAME)
live-demo: ## Start a slow, long run to watch in Live mode (TICKS=240, WALL=4)
	@docker exec svc-sim-conductor python -u -m agents.scenarios live --ticks $(or $(TICKS_LIVE),240) --wall-seconds $(or $(WALL),4)

.PHONY: run-status
run-status: ## Show recent runs
	@docker exec svc-sim-conductor python -m agents.conductor_cli status

.PHONY: verify-determinism
verify-determinism: ## Run SEED twice and compare event sequences
	@docker exec svc-sim-conductor python -u -m agents.conductor_cli determinism --seed $(SEED) --shoppers $(SHOPPERS) --ticks $(TICKS)

.PHONY: test
test: ## MCP contract tests and acceptance checks against the live stack
	docker run --rm --network svc-sim \
	  -v $(CURDIR)/ops/secrets:/run/secrets:ro \
	  -e SHOP_MCP_URL=http://shop-mcp:8000 -e STORE_OPS_MCP_URL=http://store-ops-mcp:8000 \
	  -e OBSERVABILITY_MCP_URL=http://observability-mcp:8000 -e LLM_GATEWAY_URL=http://llm-gateway:8000 \
	  -e OTEL_SDK_DISABLED=true svc-sim/py:dev python -m pytest -q -c /app/tests/pytest.ini /app/tests

.PHONY: status
status: ## Container health and memory
	@docker ps --filter name=svc-sim- --format 'table {{.Names}}\t{{.Status}}' | sort
	@docker stats --no-stream --format 'table {{.Name}}\t{{.MemUsage}}' | grep -E 'NAME|svc-sim-' | sort -k2 -h | tail -n 45

.PHONY: logs
logs: ## Tail logs for SVC (e.g. make logs SVC=conductor)
	$(DC_SVC_SIM) logs -f --tail 100 $(SVC)

.PHONY: reset
reset: ## Destroy svc-sim state (volumes, runtime flags). No backup.
	@bash ops/scripts/reset.sh

.PHONY: tunnel
tunnel: ## Print SSM port-forward commands for the UIs
	@bash ops/scripts/tunnel-help.sh

.PHONY: banned-check
banned-check: ## Fail on banned terms (BANNED_TERMS_FILE outside the repo; skipped if unset)
	@bash ops/scripts/banned-check.sh
